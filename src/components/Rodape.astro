---
import { Image } from "astro:assets";
import logoOticaLopes from "../assets/logo-oticalopes.png";
import { contatos } from "../data/contatos";

const anoAtual = new Date().getFullYear();
---

<footer class="bg-lopes-gelo border-t border-gray-200 mt-10">
  <div class="max-w-6xl mx-auto px-5 py-10">
    <div
      class="flex flex-col md:flex-row justify-between items-center gap-6 pb-8 border-b border-gray-200/80 text-center md:text-left"
    >
      <a href="/">
        <Image
          src={logoOticaLopes}
          alt="Logo Ótica Lopes"
          width={140}
          height={140}
          class="w-auto h-14 object-contain mx-auto md:mx-0"
        />
      </a>

      <div class="text-sm text-lopes-aco space-y-1">
        <p class="font-semibold text-lopes-grafite">
          Ótica Lopes — Há 10 anos cuidando da sua visão
        </p>
        <p>{contatos.endereco.resumido}</p>
        <p>
          WhatsApp:
          <a
            href={contatos.whatsappPrincipal.url}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-lopes-vermelho font-medium transition-colors"
          >
            {contatos.whatsappPrincipal.exibicao}
          </a>
          {" | "}
          <a
            href={contatos.whatsappSecundario.url}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-lopes-vermelho font-medium transition-colors"
          >
            {contatos.whatsappSecundario.exibicao}
          </a>
        </p>
      </div>

      <div>
        <a
          href={contatos.instagram.perfilUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-semibold text-lopes-grafite hover:text-lopes-vermelho transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          {contatos.instagram.usuario}
        </a>
      </div>
    </div>

    <div
      class="pt-6 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-lopes-aco"
    >
      <p>&copy; {anoAtual} Ótica Lopes. Todos os direitos reservados.</p>
      <p>
        Desenvolvido por{" "}
        <a
          href="https://sitepraja.link"
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-lopes-grafite hover:text-lopes-vermelho transition-colors"
        >
          Site pra já
        </a>
      </p>
    </div>
  </div>
</footer>