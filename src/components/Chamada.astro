---
import Botao from "./Botao.astro";
import { contatos } from "../data/contatos";
---

<section id="contato" class="px-5 py-12 md:py-16 bg-white">
  <div
    class="max-w-5xl mx-auto bg-lopes-grafite rounded-2xl p-8 sm:p-12 md:p-16 text-center shadow-lg border-b-4 border-lopes-vermelho"
  >
    <p class="text-sm font-semibold uppercase tracking-wider text-red-300">
      Ótica Lopes — Seu estilo merece esse cuidado
    </p>
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mt-3">
      Consulte os modelos disponíveis
    </h2>
    <p class="text-gray-300 text-base sm:text-lg mt-4 max-w-2xl mx-auto">
      Fale com a nossa equipe pelo WhatsApp para agendar seu exame de vista
      grátis, solicitar atendimento em domicílio ou tirar dúvidas sobre
      armações.
    </p>

    <div class="mt-8 flex flex-col sm:flex-row justify-center items-center gap-4">
      <Botao href={contatos.whatsappPrincipal.url} class="w-full sm:w-auto gap-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path>
          <path
            d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"
          ></path>
        </svg>
        WhatsApp {contatos.whatsappPrincipal.exibicao}
      </Botao>

      <Botao
        href={contatos.whatsappSecundario.url}
        style="inverted"
        class="w-full sm:w-auto gap-2"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path>
          <path
            d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"
          ></path>
        </svg>
        WhatsApp {contatos.whatsappSecundario.exibicao}
      </Botao>
    </div>

    <div class="mt-6">
      <a
        href={contatos.instagram.perfilUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-gray-300 hover:text-white transition-colors"
      >
        Ou acompanhe as novidades no Instagram:
        <span class="font-semibold underline underline-offset-4">
          {contatos.instagram.usuario}
        </span>
      </a>
    </div>
  </div>
</section>