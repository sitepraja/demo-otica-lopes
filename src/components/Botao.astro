---
interface Props {
  href: string;
  size?: "md" | "lg";
  block?: boolean;
  style?: "primary" | "outline" | "inverted";
  class?: string;
  target?: string;
  rel?: string;
  [x: string]: any;
}

const {
  href,
  block,
  size = "lg",
  style = "primary",
  class: className,
  target,
  rel,
  ...rest
} = Astro.props;

const isExternal = href.startsWith("http://") || href.startsWith("https://");
const defaultTarget = target || (isExternal ? "_blank" : undefined);
const defaultRel =
  rel || (defaultTarget === "_blank" ? "noopener noreferrer" : undefined);

const sizes = {
  lg: "px-6 py-3.5 text-base",
  md: "px-5 py-2.5 text-sm",
};

const styles = {
  primary:
    "bg-lopes-vermelho text-white hover:bg-lopes-vinho border-2 border-transparent shadow-sm",
  outline:
    "bg-white border-2 border-lopes-vermelho text-lopes-vermelho hover:bg-lopes-vermelho hover:text-white",
  inverted:
    "bg-white text-lopes-vermelho hover:bg-lopes-gelo border-2 border-transparent shadow-sm",
};
---

<a
  href={href}
  target={defaultTarget}
  rel={defaultRel}
  {...rest}
  class:list={[
    "inline-flex items-center justify-center rounded-lg text-center font-semibold transition-all duration-200 focus-visible:ring-2 ring-offset-2 ring-lopes-vermelho",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
>
  <slot />
</a>